# Server (optional)

HOST=0.0.0.0
PORT=8080

LOG_LEVEL=info # debug, info, warn, error, dpanic, panic, fatal
ERROR_DETAIL=useful # useful, verbose (verbose includes the upstream status line in errors)

# Auth

API_KEY=change-me

# Clients (optional)

# Comma-separated clients to enable, in order, or "all". The default is every non-mirror client. A client that needs
# credentials and does not have them is registered but inactive: it is skipped in combined calls and reported with a
# reason, and startup never fails for it.

# danbooru,aibooru,gelbooru,rule34,realbooru,xbooru,tbib,safebooru,yandere,konachan,sakugabooru,e621,derpibooru,twibooru,furbooru
BOORU_CLIENTS=

# Clients used when a call does not name any.

DEFAULT_CLIENTS=rule34,danbooru,gelbooru

# Sent on every upstream request. A descriptive value with contact information is required for e621 and e926, which
# reject requests without one; those clients stay inactive until this is changed from the default.

USER_AGENT=booru-mcp/0.1.0

# Rate limiting (optional)

# One global limiter is shared by every client, so a cold popular across many clients takes about one second per call.

RATE_LIMIT_RPS=1
RATE_LIMIT_BURST=1
REQUEST_TIMEOUT_SECONDS=20

# Results (optional)

MAX_LIMIT=100

# Cache (optional)

# Tag data is cached for this long. 0 disables caching entirely.

CACHE_TTL_DAYS=30

DB_PATH=booru-mcp.db

# Content policy (optional)

# The highest rating any tool may return: general, sensitive, questionable, explicit, or all.

CONTENT_RATING=all

# Comma-separated tags to exclude from queries and results. No list ships with this repository; supply your own.

BLOCKED_TAGS=

# Danbooru family (optional)

DANBOORU_URL=https://danbooru.donmai.us
DANBOORU_LOGIN=
DANBOORU_API_KEY=

AIBOORU_URL=https://aibooru.online
AIBOORU_LOGIN=
AIBOORU_API_KEY=

# Gelbooru family (optional)

# These sites require a key and user id before their API will answer.

GELBOORU_URL=https://gelbooru.com
GELBOORU_API_KEY=
GELBOORU_USER_ID=

RULE34_URL=https://rule34.xxx
RULE34_API_KEY=
RULE34_USER_ID=

REALBOORU_URL=https://realbooru.com
REALBOORU_API_KEY=
REALBOORU_USER_ID=

XBOORU_URL=https://xbooru.com
XBOORU_API_KEY=
XBOORU_USER_ID=

TBIB_URL=https://tbib.org
TBIB_API_KEY=
TBIB_USER_ID=

# No credentials are known to be required for this one.

SAFEBOORU_URL=https://safebooru.org

# Moebooru family (optional)

# Keyless. Point KONACHAN_URL at https://konachan.net for the SFW mirror.

YANDERE_URL=https://yande.re
KONACHAN_URL=https://konachan.com
SAKUGABOORU_URL=https://sakugabooru.com

# e621 family (optional)

# USER_AGENT above is the hard requirement; these credentials are optional.

E621_URL=https://e621.net
E621_LOGIN=
E621_API_KEY=

# SFW mirror of e621; excluded from the default set to avoid double counting shared tags.

E926_URL=https://e926.net
E926_LOGIN=
E926_API_KEY=

# Philomena family (optional)

# These APIs are key-gated for search.

DERPIBOORU_URL=https://derpibooru.org
DERPIBOORU_API_KEY=

TWIBOORU_URL=https://twibooru.org
TWIBOORU_API_KEY=

FURBOORU_URL=https://furbooru.org
FURBOORU_API_KEY=
