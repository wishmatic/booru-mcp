# Server (optional)

HOST=0.0.0.0
PORT=8080

LOG_LEVEL=info # debug, info, warn, error, dpanic, panic, fatal
ERROR_DETAIL=useful # useful, verbose

# Auth

API_KEY=change-me

# Clients (optional)

# danbooru, aibooru, gelbooru, rule34, realbooru, xbooru, tbib, safebooru, yandere, konachan, sakugabooru, e621,
# derpibooru, twibooru, furbooru, or all

BOORU_CLIENTS=all

DEFAULT_CLIENTS=rule34,danbooru,gelbooru

# Sent on every upstream request. A descriptive value with contact information is required for e621 and e926, which
# reject requests without one; those clients stay inactive until this is changed from the default.

USER_AGENT=booru-mcp/0.1.0

# Rate limiting (optional)

RATE_LIMIT_RPS=1
RATE_LIMIT_BURST=1
REQUEST_TIMEOUT_SECONDS=20

# Results (optional)

MAX_LIMIT=100

# Cache (optional)

# Tag data is cached for this long. 0 disables caching entirely.

CACHE_TTL_DAYS=30

DB_PATH=booru-mcp.db

# Content policy (optional)

CONTENT_RATING=all # general, sensitive, questionable, explicit, all
BLOCKED_TAGS=

# Danbooru family (optional)

DANBOORU_URL=https://danbooru.donmai.us
DANBOORU_LOGIN=
DANBOORU_API_KEY=

AIBOORU_URL=https://aibooru.online
AIBOORU_LOGIN=
AIBOORU_API_KEY=

# Gelbooru family (optional)

GELBOORU_URL=https://gelbooru.com
GELBOORU_API_KEY=
GELBOORU_USER_ID=

RULE34_URL=https://rule34.xxx
RULE34_API_KEY=
RULE34_USER_ID=

REALBOORU_URL=https://realbooru.com
REALBOORU_API_KEY=
REALBOORU_USER_ID=

XBOORU_URL=https://xbooru.com
XBOORU_API_KEY=
XBOORU_USER_ID=

TBIB_URL=https://tbib.org
TBIB_API_KEY=
TBIB_USER_ID=

SAFEBOORU_URL=https://safebooru.org

# Moebooru family (optional)

YANDERE_URL=https://yande.re
KONACHAN_URL=https://konachan.com # https://konachan.net for the SFW mirror
SAKUGABOORU_URL=https://sakugabooru.com

# e621 family (optional)

E621_URL=https://e621.net
E621_LOGIN=
E621_API_KEY=

# SFW mirror of e621; excluded from the default set to avoid double counting shared tags.

E926_URL=https://e926.net
E926_LOGIN=
E926_API_KEY=

# Philomena family (optional)

DERPIBOORU_URL=https://derpibooru.org
DERPIBOORU_API_KEY=

TWIBOORU_URL=https://twibooru.org
TWIBOORU_API_KEY=

FURBOORU_URL=https://furbooru.org
FURBOORU_API_KEY=
