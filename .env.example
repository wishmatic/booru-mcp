# Server (optional)

HOST=0.0.0.0
PORT=8080

LOG_LEVEL=info # debug, info, warn, error, dpanic, panic, fatal
ERROR_DETAIL=useful # useful, verbose

# Auth

API_KEY=change-me

# Upstream (optional)

# Sent on every upstream request, identifying this deployment to Danbooru.

USER_AGENT=booru-mcp/0.1.0

# Rate limiting (optional)

RATE_LIMIT_RPS=1
RATE_LIMIT_BURST=1
REQUEST_TIMEOUT_SECONDS=20

# The tags tool (optional)

# limit is capped at MAX_LIMIT, which is also the page size requested from the tag listing.
# offset is capped at MAX_OFFSET.

MAX_LIMIT=100
MAX_OFFSET=1000

# Content policy (optional)

BLOCKED_TAGS=

# Danbooru (optional)

# Danbooru answers anonymously, so these are not required. Setting both raises the anonymous rate limit and makes it
# less likely that a call is throttled.

DANBOORU_LOGIN=
DANBOORU_API_KEY=
